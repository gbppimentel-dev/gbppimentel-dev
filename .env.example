# CHANGE VERSION: HEARTS-CLOUDFLARE-R5 | Public frontend configuration
# Preferred heart backend: the deployed Cloudflare Worker origin (no secret/API key).
# Setup automatically writes this to .env.development.local after verified deployment.
# Live site: Settings > Secrets and variables > Actions > Variables > VITE_HEARTS_API_URL.
VITE_HEARTS_API_URL=
# Keep these existing settings until the Cloudflare cutover is verified.
# With VITE_HEARTS_API_URL blank, the current Supabase counter continues to work.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never put a Supabase secret or service-role key in a VITE_ variable.
# END OF FILE: HEARTS-CLOUDFLARE-R5
