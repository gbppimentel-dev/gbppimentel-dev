{
  "name": "gbppimentel-portfolio-hearts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute DB --local --file schema.sql",
    "db:remote": "wrangler d1 execute DB --remote --file schema.sql",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "devDependencies": {
    "wrangler": "4.151.2"
  }
}
